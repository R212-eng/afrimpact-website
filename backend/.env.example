# ============================================================
# Afrimpact backend configuration  (copy to backend/.env)
# Full reference: docs/CONFIGURATION.md
# ============================================================

# --- Core
ENVIRONMENT=development
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://afrimpact:afrimpact@localhost:5432/afrimpact
# Comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Public URL of the website (used in email links, share previews, redirects)
SITE_URL=http://localhost:5173

# --- Admin portal
# Required in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-change-me
TOKEN_HOURS=12
# First admin account, created on startup if no admin exists yet
ADMIN_EMAIL=admin@afrimpact.com
ADMIN_PASSWORD=change-me-now
# Optional machine key for scripts (header X-Admin-Key). Leave empty to disable.
ADMIN_API_KEY=

# --- Uploads (admin image uploads, served at /api/uploads)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# --- Email (SMTP). Leave SMTP_HOST empty to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 -> SMTP_USE_TLS=true ; 465 -> SMTP_USE_SSL=true and SMTP_USE_TLS=false
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=20
EMAIL_FROM="Afrimpact Website <no-reply@afrimpact.com>"
# Default inbox(es) for every form, comma separated
NOTIFY_EMAILS=info@afrimpact.com
# Optional per-form inboxes (empty = NOTIFY_EMAILS)
NOTIFY_CONTACT=
NOTIFY_CONSULTATIONS=
NOTIFY_INTERESTS=
NOTIFY_ITINERARIES=
NOTIFY_REGISTRATIONS=
NOTIFY_PITCHES=
NOTIFY_NEWSLETTER=
# Visitor gets a "we received your message" email
SEND_CONFIRMATION=true
# Shown to visitors if the contact form cannot send
SITE_CONTACT_EMAIL=info@afrimpact.com
